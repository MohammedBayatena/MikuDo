# ── Build output ────────────────────────────────────────────
bin/
obj/
publish/
artifacts/
*.nupkg

# ── Visual Studio, Rider, VS Code ───────────────────────────
.vs/
.idea/
.vscode/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.DotSettings.user
*.rsuser

# ── Claude Code's per-machine settings ──────────────────────
.claude/settings.local.json

