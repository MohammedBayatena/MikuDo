# outside the repo; these catch copies made by hand.
*.db
*-log.db
*.log
*.gguf
ggml-*.bin

# ── Operating system ────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
