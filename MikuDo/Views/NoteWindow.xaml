<Window x:Class="MikuDo.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:MikuDo.Converters"
        xmlns:ui="clr-namespace:MikuDo.Controls"
        xmlns:svc="clr-namespace:MikuDo.Services"
        xmlns:views="clr-namespace:MikuDo.Views"
        Title="{Binding FileName, StringFormat='{}{0} — MikuDo Reader'}"
        Width="960" Height="840" MinWidth="560" MinHeight="420"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/Assets/app-icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>

        <!-- On top: keeps the reader above other windows while it is pressed -->
        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="7" BorderThickness="1" Padding="9,4"
                                Background="Transparent" BorderBrush="{DynamicResource BorderSoftBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource IconPin}" Size="12" StrokeThickness="2.2" VerticalAlignment="Center"
                                         Stroke="{TemplateBinding Foreground}"/>
                                <TextBlock Text="On top" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A plain word on the reading bar -->
        <Style x:Key="ReaderBarButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A thin coloured edge. The window has no frame of its own, so without one a
         reader over a white page disappears into it. The content inside is clipped
         to the same rounded corners, so nothing draws over the edge's curve. -->
    <Border x:Name="Edge" BorderThickness="1" CornerRadius="10" BorderBrush="{DynamicResource AccentBorderStrongBrush}">
    <Grid x:Name="Body" ui:RoundedClip.Radius="9" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Title bar: the file, what it is, and the window's own buttons ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0,8,0" LastChildFill="True">
                <Image DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Source="pack://application:,,,/MikuDo;component/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding FileName}" Margin="10,0,0,0" MaxWidth="360"
                           FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding Path}"/>
                <TextBlock DockPanel.Dock="Left" Text="— MikuDo Reader" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFaintBrush}"/>
                <Border DockPanel.Dock="Left" Margin="10,0,0,0" CornerRadius="99" Padding="9,2" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding IsDirty, Converter={StaticResource Vis}}">
                    <TextBlock Text="Unsaved" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}"/>
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton Style="{StaticResource PinToggle}" Margin="0,0,10,0" ToolTip="Keep this window above other windows"
                                  IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Click="OnTop_Click"/>
                    <Button Style="{StaticResource WindowChromeButton}" Click="Minimize_Click" ToolTip="Minimise">
                        <ui:Icon Data="{StaticResource IconMinimize}" Size="14" StrokeThickness="1.8"
                                 Stroke="{DynamicResource TextFaintBrush}"/>
                    </Button>
                    <Button Style="{StaticResource WindowChromeButton}" Click="Maximize_Click" ToolTip="Maximise">
                        <ui:Icon x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Size="12" StrokeThickness="1.8"
                                 Stroke="{DynamicResource TextFaintBrush}"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Close">
                        <ui:Icon Data="{StaticResource IconClose}" Size="13" StrokeThickness="1.9">
                            <ui:Icon.Style>
                                <Style TargetType="ui:Icon">
                                    <Setter Property="Stroke" Value="{DynamicResource TextFaintBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource WindowCloseHoverForegroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Icon.Style>
                        </ui:Icon>
                    </Button>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ═══ The page: the Notes page itself, without its toolbar while reading ═══ -->
        <views:NoteView x:Name="Page" Grid.Row="1"/>

        <!-- ═══ The reading bar: edit, take it into MikuDo, or make tasks of it ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="0,8,0,18"
                Visibility="{Binding ShowReaderBar, Converter={StaticResource Vis}}">
            <Grid HorizontalAlignment="Center">
                <ui:SoftShadow CornerRadius="12" BlurRadius="28" ShadowDepth="8" ShadowOpacity="0.14"
                               Color="{DynamicResource ShadowColor}"/>
                <Border CornerRadius="12" Padding="6" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ReaderBarButton}" Content="Edit" ToolTip="Edit the note beside its preview"
                                Command="{Binding SetEditorModeCommand}" CommandParameter="Split"/>
                        <Button Style="{StaticResource ReaderBarButton}" Content="Open in MikuDo"
                                ToolTip="Move the note onto the Notes page in MikuDo" Click="OpenInMikuDo_Click"/>
                        <Border Width="1" Height="20" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
                        <Button x:Name="MakeTasksButton" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="MakeTasks_Click"
                                Visibility="{Binding IsDirty, Converter={StaticResource Vis}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource IconCheck}" Size="12" StrokeThickness="2.6" VerticalAlignment="Center"
                                         Stroke="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                <TextBlock Text="Make tasks" Margin="7,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Padding="14,8" Command="{Binding SaveCommand}"
                                ToolTip="{Binding [app.save], Source={x:Static svc:ShortcutText.InParens}, StringFormat='Write the changes to the file{0}'}"
                                Visibility="{Binding IsDirty, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource IconSave}" Size="12" StrokeThickness="2" VerticalAlignment="Center"
                                         Stroke="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                <TextBlock Text="Save to file" Margin="7,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                <TextBlock Text="{Binding [app.save], Source={x:Static svc:ShortcutText.Keys}}" Margin="8,0,0,0" FontSize="10.5" FontWeight="SemiBold" Opacity="0.85"
                                           VerticalAlignment="Center" Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ Make tasks, over the page ═══ -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding ReaderDialog, Converter={StaticResource Vis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource ScrimIn}"/>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <views:MakeTasksDialog DataContext="{Binding ReaderDialog}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Margin="24"/>
        </Grid>
    </Grid>
    </Border>
</Window>
