<Window x:Class="MikuDo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:MikuDo.Converters"
        xmlns:ui="clr-namespace:MikuDo.Controls"
        xmlns:svc="clr-namespace:MikuDo.Services"
        xmlns:views="clr-namespace:MikuDo.Views"
        xmlns:vm="clr-namespace:MikuDo.ViewModels"
        Title="MikuDo" Height="820" Width="1240"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource CanvasBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Assets/app-icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>
        <conv:BoolToOnOffConverter x:Key="BoolOnOff"/>
        <conv:DoneToDecorationsConverter x:Key="Strike"/>
        <conv:EqualsToOnOffConverter x:Key="EqOnOff"/>
        <conv:ShowIfBothConverter x:Key="ShowIfBoth"/>
        <conv:ShowIfNeitherConverter x:Key="ShowIfNeither"/>
        <conv:NotConverter x:Key="Not"/>
        <conv:SidebarColumnConverter x:Key="SidebarColumn"/>
        <conv:ScaleConverter x:Key="Scale"/>

        <!-- A sidebar section's heading. Clicking it folds the section; a chevron
             shows on hover, and stays while the section is folded. -->
        <Style x:Key="SectionHeader" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextGhostBrush}"/>
            <Setter Property="Padding" Value="8,3,6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ui:Icon x:Name="chevron" Data="{StaticResource IconChevronDown}" Size="10" StrokeThickness="2.6"
                                         Margin="5,0,0,0" Opacity="0" VerticalAlignment="Center" Stroke="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="hint" Text="Collapse" Margin="5,0,0,0" FontSize="10" Opacity="0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextGhostSoftBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="off">
                                <Setter TargetName="chevron" Property="Data" Value="{StaticResource IconChevronRight}"/>
                                <Setter TargetName="chevron" Property="Opacity" Value="1"/>
                                <Setter TargetName="hint" Property="Text" Value="Expand"/>
                                <Setter TargetName="hint" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chevron" Property="Opacity" Value="1"/>
                                <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                <Setter TargetName="hint" Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A workspace as a square, for the folded row of workspaces -->
        <Style x:Key="WorkspaceSquare" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" BorderThickness="1" Background="Transparent"
                                BorderBrush="{DynamicResource BorderSoftBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small word that acts, quiet until pointed at: Clear on the Recent row -->
        <Style x:Key="QuietWordButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="text" Text="{TemplateBinding Content}" Background="Transparent" Padding="4,0"
                                   VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Rows of the NOTES tree. Each row is one Button whose template draws
            everything: the guide lines, the indent, the icons and the name. Icons
            take the row's colour by TemplateBinding and text inherits it, so a row
            costs no lookups up the tree, and a folder of hundreds of notes opens quickly.
        -->
        <Style x:Key="NoteTreeRow" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="600"/>
            <EventSetter Event="Click" Handler="NoteTreeRow_Click"/>
            <EventSetter Event="ContextMenuOpening" Handler="NoteRow_ContextMenuOpening"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoteTreeCount" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <!-- Recent: the notes opened lately -->
        <Style x:Key="NoteTreeRecent" TargetType="Button" BasedOn="{StaticResource NoteTreeRow}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="{Binding Spacing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <ui:Icon x:Name="chevron" DockPanel.Dock="Left" Data="{StaticResource IconChevronRight}" Size="12"
                                         StrokeThickness="2.6" Stroke="{TemplateBinding Foreground}"/>
                                <ui:Icon DockPanel.Dock="Left" Margin="6,0,0,0" Data="{StaticResource IconClock}" Size="14"
                                         StrokeThickness="2" Stroke="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="count" Text="{Binding Count}" Style="{StaticResource NoteTreeCount}"/>
                                <Button x:Name="clear" DockPanel.Dock="Right" Style="{StaticResource QuietWordButton}" Content="Clear"
                                        Margin="6,-2,-4,-2" Visibility="Collapsed" Click="ClearRecent_Click"
                                        ToolTip="Clear the Recent list. The files stay where they are."/>
                                <TextBlock Text="Recent" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="count" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="clear" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="chevron" Property="Data" Value="{StaticResource IconChevronDown}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A folder: one opened under Notes (bold, its icon filled), or one inside it -->
        <Style x:Key="NoteTreeFolder" TargetType="Button" BasedOn="{StaticResource NoteTreeRow}">
            <Setter Property="Margin" Value="{Binding Spacing}"/>
            <Setter Property="ToolTip" Value="{Binding Path}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ui:TreeGuides Depth="{Binding Depth}" Stroke="{DynamicResource DividerBrush}"/>
                            <Border x:Name="bd" Margin="{Binding Indent}" CornerRadius="7" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <ui:Icon x:Name="chevron" DockPanel.Dock="Left" Data="{StaticResource IconChevronRight}" Size="11"
                                             StrokeThickness="2.6" Stroke="{TemplateBinding Foreground}"/>
                                    <ui:Icon x:Name="icon" DockPanel.Dock="Left" Margin="6,0,0,0" Data="{StaticResource IconFolder}" Size="14"
                                             StrokeThickness="1.8" Stroke="{TemplateBinding Foreground}"/>
                                    <TextBlock x:Name="count" Text="{Binding Count}" Style="{StaticResource NoteTreeCount}"/>
                                    <TextBlock x:Name="name" Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="chevron" Property="Data" Value="{StaticResource IconChevronDown}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowCount}" Value="False">
                                <Setter TargetName="count" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter TargetName="chevron" Property="Size" Value="12"/>
                                <Setter TargetName="icon" Property="Size" Value="15"/>
                                <Setter TargetName="icon" Property="Fill" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="CornerRadius" Value="8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,6"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRoot}" Value="True"/>
                        <Condition Binding="{Binding IsExpanded}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hidden: what the user kept out of one folder's tree -->
        <Style x:Key="NoteTreeHidden" TargetType="Button" BasedOn="{StaticResource NoteTreeRow}">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
            <Setter Property="ToolTip" Value="Kept out of this folder's tree. Right-click one to show it again."/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ui:TreeGuides Depth="{Binding Depth}" Stroke="{DynamicResource DividerBrush}"/>
                            <Border x:Name="bd" Margin="{Binding Indent}" CornerRadius="7" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <ui:Icon x:Name="chevron" DockPanel.Dock="Left" Data="{StaticResource IconChevronRight}" Size="11"
                                             StrokeThickness="2.6" Stroke="{TemplateBinding Foreground}"/>
                                    <ui:Icon DockPanel.Dock="Left" Margin="6,0,0,0" Data="{StaticResource IconEyeOff}" Size="14"
                                             StrokeThickness="1.8" Stroke="{TemplateBinding Foreground}"/>
                                    <TextBlock Text="{Binding Count}" Style="{StaticResource NoteTreeCount}"/>
                                    <TextBlock Text="Hidden" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="chevron" Property="Data" Value="{StaticResource IconChevronDown}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A note: its unsaved dot on the right; marked while it is the one on screen -->
        <Style x:Key="NoteTreeNote" TargetType="Button" BasedOn="{StaticResource NoteTreeRow}">
            <Setter Property="ToolTip" Value="{Binding Path}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ui:TreeGuides Depth="{Binding Depth}" Stroke="{DynamicResource DividerBrush}"/>
                            <Border x:Name="bd" Margin="{Binding Indent}" CornerRadius="7" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <ui:Icon DockPanel.Dock="Left" Data="{StaticResource IconNoteSmall}" Size="13"
                                             StrokeThickness="1.9" Stroke="{TemplateBinding Foreground}"/>
                                    <Ellipse x:Name="dot" DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0"
                                             VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                    <Button x:Name="popout" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                            Width="20" Height="20" Margin="4,-2,-4,-2" Visibility="Collapsed"
                                            ToolTip="Open in a new window" Click="NoteRowPopOut_Click">
                                        <ui:Icon Data="{StaticResource IconPopOut}" Size="12" StrokeThickness="2.1"
                                                 Stroke="{DynamicResource TextFaintBrush}"/>
                                    </Button>
                                    <TextBlock x:Name="name" Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="popout" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlignWithFolders}" Value="True">
                    <Setter Property="Padding" Value="25,5,8,5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- After the first notes of a folder holding a great many: the next batch -->
        <Style x:Key="NoteTreeMore" TargetType="Button" BasedOn="{StaticResource NoteTreeRow}">
            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="ToolTip" Value="{Binding Remaining, StringFormat='{}{0} more notes in this folder'}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ui:TreeGuides Depth="{Binding Depth}" Stroke="{DynamicResource DividerBrush}"/>
                            <Border x:Name="bd" Margin="{Binding Indent}" CornerRadius="7" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <TextBlock Text="{Binding Remaining}" Style="{StaticResource NoteTreeCount}"/>
                                    <TextBlock Text="{Binding Label}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlignWithFolders}" Value="True">
                    <Setter Property="Padding" Value="25,5,8,5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
        <!-- Title bar: the brand on the left. It is not hit-testable, so dragging it moves the window. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,9,0,0">
            <Image Width="26" Height="26" Source="pack://application:,,,/MikuDo;component/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="MikuDo" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <!-- Quick Access: the search bar, centred on the window. It takes input, so the
             caption lets clicks through to it. Open, it widens over its list and takes
             the accent's edge and glow. -->
        <Grid x:Name="SearchBar" Width="500" Height="30" Margin="0,7,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
              DataContext="{Binding QuickAccess}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="SearchGlow" Margin="-3" CornerRadius="12" BorderThickness="3" Opacity="0.16"
                    BorderBrush="{DynamicResource FocusRingBrush}" IsHitTestVisible="False"
                    Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"/>
            <Border CornerRadius="9" Padding="10,0" Background="{DynamicResource SurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:Icon Grid.Column="0" Data="{StaticResource IconSearch}" Size="14" StrokeThickness="2"
                             Stroke="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>

                    <!-- One kind only: "> Commands" -->
                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="6" Padding="7,1" BorderThickness="1" VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                            Visibility="{Binding HasMode, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal" TextElement.FontSize="11.5" TextElement.FontWeight="Bold"
                                    TextElement.Foreground="{DynamicResource AccentDarkBrush}">
                            <TextBlock Text="{Binding ModePrefix}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ModeName}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="SearchBox" Grid.Column="2" Margin="8,0,6,0" Padding="0"
                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                             FontSize="12.5" ui:Placeholder.Text="{Binding Placeholder}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                             LostKeyboardFocus="SearchBox_LostKeyboardFocus">
                        <!-- What is typed reads a little heavier than the hint in the empty bar -->
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Closed and empty: the keys that open it -->
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding OpenCaps}" Focusable="False" IsTabStop="False"
                                  VerticalAlignment="Center">
                        <ItemsControl.Visibility>
                            <MultiBinding Converter="{StaticResource ShowIfNeither}">
                                <Binding Path="IsOpen"/>
                                <Binding Path="HasQuery"/>
                            </MultiBinding>
                        </ItemsControl.Visibility>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="5,2" Margin="3,0,0,0" Background="{DynamicResource HoverBrush}">
                                    <TextBlock Text="{Binding}" FontSize="9.5" FontWeight="Medium"
                                               Foreground="{DynamicResource TextSubtleBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Open and empty: Esc closes it -->
                    <Border Grid.Column="3" Style="{StaticResource KeyCap}" VerticalAlignment="Center">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource ShowIfBoth}">
                                <Binding Path="IsOpen"/>
                                <Binding Path="HasQuery" Converter="{StaticResource Not}"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <TextBlock Text="Esc" Style="{StaticResource KeyCapText}" Foreground="{DynamicResource TextFaintBrush}"/>
                    </Border>

                    <!-- Open and typed into: how many things match -->
                    <TextBlock Grid.Column="3" Text="{Binding ResultLabel}" FontSize="11.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource ShowIfBoth}">
                                <Binding Path="IsOpen"/>
                                <Binding Path="HasQuery"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- Closed with a search kept, as the search board shows it: × ends it -->
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="18" Height="18"
                            Click="ClearSearch_Click" ToolTip="Clear search">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource ShowIfBoth}">
                                <Binding Path="IsOpen" Converter="{StaticResource Not}"/>
                                <Binding Path="HasQuery"/>
                            </MultiBinding>
                        </Button.Visibility>
                        <ui:Icon Data="{StaticResource IconClose}" Size="11" StrokeThickness="2.2"
                                 Stroke="{DynamicResource TextFaintBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Window controls live in the canvas margin, outside the app card -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,9,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WindowChromeButton}" Click="Minimize_Click" ToolTip="Minimise">
                <ui:Icon Data="{StaticResource IconMinimize}" Size="14" StrokeThickness="1.8"
                         Stroke="{DynamicResource TextFaintBrush}"/>
            </Button>
            <Button Style="{StaticResource WindowChromeButton}" Click="Maximize_Click" ToolTip="Maximise">
                <ui:Icon x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Size="12" StrokeThickness="1.8"
                         Stroke="{DynamicResource TextFaintBrush}"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Close">
                <!-- On the red hover the cross takes the colour made to read on it -->
                <ui:Icon Data="{StaticResource IconClose}" Size="13" StrokeThickness="1.9">
                    <ui:Icon.Style>
                        <Style TargetType="ui:Icon">
                            <Setter Property="Stroke" Value="{DynamicResource TextFaintBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource WindowCloseHoverForegroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Icon.Style>
                </ui:Icon>
            </Button>
        </StackPanel>

        <!--
            The card's shadow is a SoftShadow behind it, not an Effect on it.
            An Effect is worked out again whenever anything it covers is
            redrawn; on the card that is the entire application, so a blinking
            caret, a hover or a scroll would re-blur every pixel of the window.
        -->
        <ui:SoftShadow x:Name="AppCardShadow" Margin="8,44,8,8" CornerRadius="10"
                       BlurRadius="40" ShadowDepth="12" ShadowOpacity="0.10"
                       Color="{DynamicResource ShadowColor}"/>

        <!-- ═══ App card ═══ -->
        <Border x:Name="AppCard" Margin="8,44,8,8" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                SnapsToDevicePixels="True">
            <Border x:Name="AppCardClip" CornerRadius="10" ui:RoundedClip.Radius="10"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition>
                            <ColumnDefinition.Width>
                                <MultiBinding Converter="{StaticResource SidebarColumn}" ConverterParameter="52">
                                    <Binding Path="IsSidebarCollapsed"/>
                                    <Binding Path="SidebarWidth"/>
                                </MultiBinding>
                            </ColumnDefinition.Width>
                        </ColumnDefinition>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ Sidebar ═══ -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0"
                            Visibility="{Binding IsSidebarCollapsed,
                                         Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <DockPanel Margin="14,16,14,16">



                            <!-- The menu's heading, with the button that folds the sidebar away -->
                            <Grid DockPanel.Dock="Top" Margin="8,0,4,8">
                                <TextBlock Text="MAIN MENU" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource OutlinedIconButton}" Width="26" Height="26"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding [window.sidebar], Source={x:Static svc:ShortcutText.InParens}, StringFormat='Hide the sidebar{0}'}"
                                        Command="{Binding ToggleSidebarCommand}">
                                    <ui:Icon Data="{StaticResource IconChevronLeft}" Size="12" StrokeThickness="2.4"
                                             Stroke="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Bottom rail pinned below -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>

                                <Button Style="{StaticResource NavButton}" Command="{Binding ToggleThemeCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:Icon Grid.Column="0" Data="{StaticResource IconMoon}" Size="17"
                                                 Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Toggle theme" Margin="10,0,0,0" FontSize="13"
                                                   FontWeight="Medium" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Border Grid.Column="2" Width="28" Height="16" CornerRadius="4" Padding="2"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SwitchTrackOffBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SwitchTrackOnBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource SwitchKnobBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToAboutCommand}"
                                        Tag="{Binding CurrentPage, Converter={StaticResource EqOnOff}, ConverterParameter=About}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Icon Data="{StaticResource IconAbout}" Size="17"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Text="About" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   FontSize="13" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToSettingsCommand}"
                                        Tag="{Binding CurrentPage, Converter={StaticResource EqOnOff}, ConverterParameter=Settings}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Icon Data="{StaticResource IconSettings}" Size="17"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   FontSize="13" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!--
                                The GIF chosen in Settings, just under the tip; with none
                                chosen there is no box at all. The box is nearly square,
                                nine tenths as tall as it is wide, so it grows with the
                                sidebar. The player decodes it once at this size and
                                animates only while it can be seen.
                            -->
                            <Grid DockPanel.Dock="Bottom" Margin="2,10,2,0"
                                  Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Scale}, ConverterParameter=0.9}"
                                  Visibility="{Binding HasSidebarGif, Converter={StaticResource Vis}}">
                                <!-- The GIF in a rounded frame; its two actions appear while the pointer is over it -->
                                <Border x:Name="GifFrame" CornerRadius="10" Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <Grid ui:RoundedClip.Radius="9">
                                        <ui:GifPlayer FilePath="{Binding SidebarGifPath}"/>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="2"
                                                CornerRadius="7" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=GifFrame}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                                        ToolTip="Choose another GIF" Command="{Binding ChooseGifCommand}">
                                                    <ui:Icon Data="{StaticResource IconImage}" Size="12" StrokeThickness="2"
                                                             Stroke="{DynamicResource TextSecondaryBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                                        ToolTip="Remove the GIF" Command="{Binding RemoveGifCommand}">
                                                    <ui:Icon Data="{StaticResource IconClose}" Size="10" StrokeThickness="2.4"
                                                             Stroke="{DynamicResource TextSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--
                                A tip, in the quiet space under the workspaces: small,
                                muted, and still. It changes every few minutes or on
                                demand, closes with ×, and Settings turns tips off. In
                                Flat it is a strip across the sidebar, its edges borders.
                            -->
                            <Border DockPanel.Dock="Bottom" Margin="{ui:ByLayout Islands='2,10,2,0', Flat='-14,10,-14,0'}"
                                    CornerRadius="{ui:ByLayout Islands=8, Flat=0}" Padding="{ui:ByLayout Islands='11,9,6,8', Flat='24,9,18,8'}"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="{ui:ByLayout Islands=1, Flat='0,1,0,1'}"
                                    Visibility="{Binding ShowTip, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,-3,0,0">
                                            <Button Style="{StaticResource IconButton}" Width="18" Height="18" ToolTip="Previous tip"
                                                    Command="{Binding PreviousTipCommand}">
                                                <ui:Icon Data="{StaticResource IconChevronLeft}" Size="10" StrokeThickness="2.4"
                                                         Stroke="{DynamicResource TextFaintBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="18" Height="18" ToolTip="Next tip"
                                                    Command="{Binding NextTipCommand}">
                                                <ui:Icon Data="{StaticResource IconChevronRight}" Size="10" StrokeThickness="2.4"
                                                         Stroke="{DynamicResource TextFaintBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="18" Height="18"
                                                    ToolTip="Hide tips until next time (turn them off in Settings)"
                                                    Command="{Binding DismissTipCommand}">
                                                <ui:Icon Data="{StaticResource IconClose}" Size="8" StrokeThickness="2.6"
                                                         Stroke="{DynamicResource TextFaintBrush}"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="TIP" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TipLabelBrush}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Tip}" Margin="0,4,6,0" FontSize="11.5" LineHeight="16"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Scrollable middle -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-14,0,0,0" Padding="14,0,0,0">
                                <ScrollViewer.Resources>
                                    <!-- WPF's own scroll bar style sets a MinWidth of the system scroll bar
                                         width (17px), which outranks the app style's 4px Width -->
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                        <Setter Property="MinWidth" Value="0"/>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>

                                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToDashboardCommand}"
                                            Tag="{Binding CurrentPage, Converter={StaticResource EqOnOff}, ConverterParameter=Dashboard}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Icon Data="{StaticResource IconDashboard}" Size="17"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToVaultCommand}"
                                            Tag="{Binding CurrentPage, Converter={StaticResource EqOnOff}, ConverterParameter=Vault}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Icon Data="{StaticResource IconVault}" Size="17"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="Vault" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToTrashCommand}"
                                            Tag="{Binding CurrentPage, Converter={StaticResource EqOnOff}, ConverterParameter=Trash}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Icon Data="{StaticResource IconTrash}" Size="17"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="Trash" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Workspaces: the heading folds them away; the button beside it shows them as a row of squares -->
                                    <DockPanel Margin="0,16,0,6" LastChildFill="False" Background="Transparent"
                                               ContextMenuOpening="WorkspaceHeader_ContextMenuOpening">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource SectionHeader}" Content="WORKSPACE"
                                                Command="{Binding ToggleWorkspacesSectionCommand}"
                                                Tag="{Binding IsWorkspacesOpen, Converter={StaticResource BoolOnOff}}"/>
                                        <Button DockPanel.Dock="Right" Width="22" Height="22" Command="{Binding ToggleWorkspacesCompactCommand}"
                                                Visibility="{Binding IsWorkspacesOpen, Converter={StaticResource Vis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="ToolTip" Value="Show as squares"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWorkspacesCompact}" Value="True">
                                                            <Setter Property="ToolTip" Value="Show as a list"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <ui:Icon Size="13" StrokeThickness="2" Stroke="{DynamicResource TextFaintBrush}">
                                                <ui:Icon.Style>
                                                    <Style TargetType="ui:Icon">
                                                        <Setter Property="Data" Value="{StaticResource IconSquares}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorkspacesCompact}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconList}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Icon.Style>
                                            </ui:Icon>
                                        </Button>
                                    </DockPanel>

                                    <!-- Folded to a row: as many squares as fit, the last one counting the rest -->
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,4"
                                                Visibility="{Binding ShowWorkspaceSquares, Converter={StaticResource Vis}}">
                                        <ItemsControl ItemsSource="{Binding WorkspaceSquares}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource WorkspaceSquare}" ToolTip="{Binding Name}"
                                                            AllowDrop="True" DragOver="Workspace_DragOver" Drop="Workspace_Drop"
                                                            Command="{Binding DataContext.NavigateToWorkspaceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding IsActive, Converter={StaticResource BoolOnOff}}">
                                                        <ui:Icon Data="{StaticResource IconWorkspace}" Size="16">
                                                            <ui:Icon.Style>
                                                                <Style TargetType="ui:Icon">
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:Icon.Style>
                                                        </ui:Icon>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource WorkspaceSquare}" Command="{Binding ShowAllWorkspacesCommand}"
                                                ToolTip="Show every workspace"
                                                Visibility="{Binding HasMoreWorkspaces, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding MoreWorkspaces, StringFormat='+{0}'}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- The full list -->
                                    <StackPanel Visibility="{Binding ShowWorkspaceList, Converter={StaticResource Vis}}">
                                        <ItemsControl ItemsSource="{Binding Workspaces}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource NavButton}" AllowDrop="True"
                                                            DragOver="Workspace_DragOver" Drop="Workspace_Drop"
                                                            MouseDoubleClick="WorkspaceRow_DoubleClick"
                                                            Command="{Binding DataContext.NavigateToWorkspaceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding IsActive, Converter={StaticResource BoolOnOff}}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Rename" Click="RenameWorkspace_Click"/>
                                                                <MenuItem Header="Delete workspace" Click="DeleteWorkspace_Click"
                                                                          Foreground="{DynamicResource DangerBrush}"
                                                                          Visibility="{Binding CanDelete, Converter={StaticResource Vis}}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ui:Icon Grid.Column="0" Data="{StaticResource IconWorkspace}" Size="17" StrokeThickness="1.6"
                                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,8,0" FontSize="13"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       Visibility="{Binding IsRenaming, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                            <!-- Enter keeps the name, Escape drops it, clicking away keeps it -->
                                                            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Margin="6,-3,0,-3" Padding="5,3"
                                                                     Style="{StaticResource SmallInputBox}" FontSize="12.5"
                                                                     Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Visibility="{Binding IsRenaming, Converter={StaticResource Vis}}"
                                                                     IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                                     KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                                                            <!-- The count badge gives way to the row's actions while the row is hovered -->
                                                            <Border Grid.Column="2" MinWidth="20" Height="20" CornerRadius="5" Padding="6,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource BadgeIdleBrush}"/>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource BadgeActiveBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                                                         RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Count}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BadgeForegroundBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <StackPanel.Visibility>
                                                                    <MultiBinding Converter="{StaticResource ShowIfBoth}">
                                                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=Button}"/>
                                                                        <Binding Path="IsRenaming" Converter="{StaticResource Not}"/>
                                                                    </MultiBinding>
                                                                </StackPanel.Visibility>
                                                                <Button Width="20" Height="20" Style="{StaticResource IconButton}"
                                                                        ToolTip="Rename (or double-click)" Click="RenameWorkspace_Click">
                                                                    <ui:Icon Data="{StaticResource IconPencil}" Size="13"
                                                                             Stroke="{DynamicResource TextFaintBrush}"/>
                                                                </Button>
                                                                <Button Width="20" Height="20" Margin="2,0,0,0" Style="{StaticResource IconButton}"
                                                                        ToolTip="Delete workspace" Click="DeleteWorkspace_Click"
                                                                        Visibility="{Binding CanDelete, Converter={StaticResource Vis}}">
                                                                    <ui:Icon Data="{StaticResource IconTrash}" Size="13"
                                                                             Stroke="{DynamicResource TextFaintBrush}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Style="{StaticResource NavButton}" Command="{Binding ShowAddWorkspaceCommand}"
                                                Visibility="{Binding IsAddingWorkspace, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Icon Data="{StaticResource IconPlus}" Size="17" StrokeThickness="1.8"
                                                         Stroke="{DynamicResource TextGhostSoftBrush}"/>
                                                <TextBlock Text="Add Workspace" Margin="10,0,0,0" VerticalAlignment="Center"
                                                           FontSize="13" Foreground="{DynamicResource TextFaintBrush}"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Margin="0,4,0,0"
                                                    Visibility="{Binding IsAddingWorkspace, Converter={StaticResource Vis}}">
                                            <TextBox x:Name="NewWorkspaceBox" Style="{StaticResource SmallInputBox}"
                                                     ui:Placeholder.Text="Workspace name"
                                                     KeyDown="WorkspaceInput_KeyDown"
                                                     Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Add" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                                        Command="{Binding ConfirmAddWorkspaceCommand}"/>
                                                <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="11,6" Margin="6,0,0,0"
                                                        Command="{Binding CancelAddWorkspaceCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Notes: Markdown files opened in MikuDo, newest first -->
                                    <DockPanel Margin="0,14,0,4" LastChildFill="False">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource SectionHeader}" Content="NOTES"
                                                Command="{Binding ToggleNotesSectionCommand}"
                                                Tag="{Binding IsNotesOpen, Converter={StaticResource BoolOnOff}}"/>
                                        <Button x:Name="NotesAddButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Width="22" Height="22" ToolTip="Open a note, or make a new one" Click="NotesAdd_Click">
                                            <ui:Icon Data="{StaticResource IconPlus}" Size="13" StrokeThickness="2.4"
                                                     Stroke="{DynamicResource TextFaintBrush}"/>
                                        </Button>
                                    </DockPanel>
                                    <StackPanel Visibility="{Binding IsNotesOpen, Converter={StaticResource Vis}}">
                                        <!-- Recent, then each opened folder: one row per line, indented by depth -->
                                        <ItemsControl ItemsSource="{Binding NoteRows}" Focusable="False">
                                            <ItemsControl.Resources>
                                                <DataTemplate DataType="{x:Type vm:RecentGroupRow}">
                                                    <Button Style="{StaticResource NoteTreeRecent}" ToolTip="Notes opened lately"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type vm:FolderRow}">
                                                    <Button Style="{StaticResource NoteTreeFolder}"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type vm:HiddenGroupRow}">
                                                    <Button Style="{StaticResource NoteTreeHidden}"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type vm:NoteRow}">
                                                    <Button Style="{StaticResource NoteTreeNote}"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type vm:MoreNotesRow}">
                                                    <Button Style="{StaticResource NoteTreeMore}"/>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type vm:EmptyFolderRow}">
                                                    <Grid>
                                                        <ui:TreeGuides Depth="{Binding Depth}" Stroke="{DynamicResource DividerBrush}"/>
                                                        <TextBlock Margin="{Binding Indent}" Padding="8,6,8,7" FontSize="11.5" LineHeight="17"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}"
                                                                   Visibility="{Binding IsMissing, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                            <Run Text="No .md files here yet."/>
                                                            <LineBreak/>
                                                            <Hyperlink Click="EmptyFolderNewNote_Click" Foreground="{DynamicResource AccentDarkBrush}">New note here</Hyperlink>
                                                        </TextBlock>
                                                        <TextBlock Margin="{Binding Indent}" Padding="8,6,8,7" FontSize="11.5" LineHeight="17"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}"
                                                                   Text="This folder is no longer on disk."
                                                                   Visibility="{Binding IsMissing, Converter={StaticResource Vis}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.Resources>
                                        </ItemsControl>
                                        <Button Margin="0,2,0,0" Padding="10,8" Cursor="Hand" Command="{Binding OpenNoteFileCommand}"
                                                ToolTip="{Binding [note.open], Source={x:Static svc:ShortcutText.InParens}, StringFormat='Open a Markdown file{0}'}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Rectangle x:Name="frame" RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="4 3"
                                                                   Stroke="{DynamicResource DashBorderBrush}" Fill="Transparent"/>
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="frame" Property="Fill" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <DockPanel>
                                                <ui:Icon DockPanel.Dock="Left" Data="{StaticResource IconPlus}" Size="14" StrokeThickness="2.2"
                                                         Stroke="{DynamicResource TextFaintBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding [note.open], Source={x:Static svc:ShortcutText.Keys}}" FontSize="10.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFaintBrush}"/>
                                                <TextBlock Text="Open file…" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                                            </DockPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- ═══ Page ═══ -->
                    <ui:AnimatedContentControl Grid.Column="1" Content="{Binding CurrentView}"/>

                    <!--
                        The sidebar's edge. It straddles the sidebar's border, after the page
                        so it is above it and before the dialogs so they cover it, and draws
                        its line only while pointed at or dragged. A double click puts the
                        width back.
                    -->
                    <Thumb Grid.Column="0" Width="10" Margin="0,0,-5,0" HorizontalAlignment="Right"
                           Cursor="SizeWE" ToolTip="Drag to resize · double-click to reset"
                           DragDelta="SidebarEdge_DragDelta" DragCompleted="SidebarEdge_DragCompleted"
                           MouseDoubleClick="SidebarEdge_DoubleClick"
                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border x:Name="line" Width="2" CornerRadius="1" Margin="0,14" HorizontalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}" Opacity="0"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="line" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="line" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <!-- Collapsed, the sidebar keeps an icon rail: shut but plainly
                         still there, and the main destinations stay one click away -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Vis}}">
                        <DockPanel Margin="0,16,0,16">
                            <StackPanel DockPanel.Dock="Top">
                                <Button Style="{StaticResource OutlinedIconButton}" Width="30" Height="26"
                                        ToolTip="{Binding [window.sidebar], Source={x:Static svc:ShortcutText.InParens}, StringFormat='Show the sidebar{0}'}" Command="{Binding ToggleSidebarCommand}">
                                    <ui:Icon Data="{StaticResource IconChevronRight}" Size="13" StrokeThickness="2.6"
                                             Stroke="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Border Height="1" Margin="10,10,10,10" Background="{DynamicResource DividerBrush}"/>

                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,0,4"
                                        ToolTip="Dashboard" Command="{Binding NavigateToDashboardCommand}">
                                    <ui:Icon Data="{StaticResource IconDashboard}" Size="17"
                                             StrokeThickness="1.9" Stroke="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,0,4"
                                        ToolTip="Vault" Command="{Binding NavigateToVaultCommand}">
                                    <ui:Icon Data="{StaticResource IconVault}" Size="17"
                                             StrokeThickness="1.9" Stroke="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                        ToolTip="Trash" Command="{Binding NavigateToTrashCommand}">
                                    <ui:Icon Data="{StaticResource IconTrash}" Size="17"
                                             StrokeThickness="1.9" Stroke="{DynamicResource TextSecondaryBrush}"/>
                                </Button>

                                <Border Height="1" Margin="10,10,10,10" Background="{DynamicResource DividerBrush}"/>

                                <ItemsControl ItemsSource="{Binding Workspaces}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,0,4"
                                                    ToolTip="{Binding Name}"
                                                    Command="{Binding DataContext.NavigateToWorkspaceCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ui:Icon Data="{StaticResource IconWorkspace}" Size="16">
                                                    <ui:Icon.Style>
                                                        <Style TargetType="ui:Icon">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Icon.Style>
                                                </ui:Icon>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,0,4"
                                        ToolTip="{Binding [theme.toggle], Source={x:Static svc:ShortcutText.InParens}, StringFormat='Toggle theme{0}'}" Command="{Binding ToggleThemeCommand}">
                                    <ui:Icon Data="{StaticResource IconMoon}" Size="17"
                                             StrokeThickness="1.9" Stroke="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                        ToolTip="Settings" Command="{Binding NavigateToSettingsCommand}">
                                    <ui:Icon Data="{StaticResource IconSettings}" Size="17"
                                             StrokeThickness="1.9" Stroke="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>

                            <Grid/>
                        </DockPanel>
                    </Border>

                    <!-- ═══ Modals ═══ -->
                    <!-- The star rows and columns give the dialog exactly 80% of the app area -->
                    <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
                          Visibility="{Binding AddTask, Converter={StaticResource Vis}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ScrimIn}"/>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="8*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <views:AddTaskDialog Grid.Row="1" Grid.Column="1" DataContext="{Binding AddTask}"/>
                    </Grid>

                    <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
                          Visibility="{Binding AiImport, Converter={StaticResource Vis}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ScrimIn}"/>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:AiImportDialog DataContext="{Binding AiImport}" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" Margin="32"/>
                    </Grid>

                    <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
                          Visibility="{Binding MakeTasks, Converter={StaticResource Vis}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ScrimIn}"/>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:MakeTasksDialog DataContext="{Binding MakeTasks}" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" Margin="32"/>
                    </Grid>

                    <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
                          Visibility="{Binding LabelSuggest, Converter={StaticResource Vis}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ScrimIn}"/>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:LabelSuggestDialog DataContext="{Binding LabelSuggest}" VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" Margin="32"/>
                    </Grid>

                    <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
                          Visibility="{Binding Export, Converter={StaticResource Vis}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource ScrimIn}"/>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:ExportDialog DataContext="{Binding Export}" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Margin="32"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- The list under the bar, in a popup of its own. The task page's and the note
             page's previews are browser windows, which draw over anything inside this
             window; a popup is a window above them. The margin leaves room for the
             shadow, and the offset takes it back, so the list lines up with the bar. -->
        <Popup x:Name="QuickPopup" PlacementTarget="{Binding ElementName=SearchBar}" Placement="Bottom"
               HorizontalOffset="-40" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="False">
            <Grid x:Name="QuickHost" Margin="40,6,40,64">
                <views:QuickAccessPanel x:Name="QuickPanel" Width="640" DataContext="{Binding QuickAccess}"/>
            </Grid>
        </Popup>
    </Grid>
</Window>
