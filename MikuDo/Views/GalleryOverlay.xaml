<UserControl x:Class="MikuDo.Views.GalleryOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MikuDo.Converters"
             xmlns:ui="clr-namespace:MikuDo.Controls"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>

        <Style x:Key="GalleryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{DynamicResource LightboxButtonBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The window behind this draws the blurred app and the scrim; a click on bare backdrop closes -->
    <Grid x:Name="Backdrop" Background="Transparent" MouseLeftButtonDown="Backdrop_MouseDown"
          TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,22,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountLabel}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource LightboxTextBrush}"/>
                <TextBlock Text="{Binding Name}" Margin="12,0,0,0" FontSize="12" MaxWidth="520"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LightboxTextFaintBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GalleryButton}" Width="36" Height="36"
                    ToolTip="Save image (Ctrl+S)" Command="{Binding SaveCommand}"
                    Visibility="{Binding HasImage, Converter={StaticResource Vis}}">
                <ui:Icon Data="{StaticResource IconDownload}" Size="16" Stroke="{DynamicResource LightboxIconBrush}" StrokeThickness="2"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource GalleryButton}" Width="36" Height="36" Margin="8,0,0,0"
                    ToolTip="Close (Esc)" Command="{Binding CloseCommand}">
                <ui:Icon Data="{StaticResource IconClose}" Size="16" Stroke="{DynamicResource LightboxIconBrush}" StrokeThickness="2.2"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="22,14,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource GalleryButton}" Width="44" Height="44"
                    VerticalAlignment="Center" ToolTip="Previous (←)" Command="{Binding PreviousCommand}"
                    Visibility="{Binding HasSeveral, Converter={StaticResource Vis}}">
                <ui:Icon Data="{StaticResource IconArrowLeftLarge}" Size="18" Stroke="{DynamicResource LightboxIconBrush}" StrokeThickness="2.2"/>
            </Button>

            <!-- The image, fitted; the wheel zooms it about the pointer and a drag moves it while zoomed -->
            <Grid x:Name="Stage" Grid.Column="1" Margin="18,0" Background="Transparent" ClipToBounds="True"
                  MouseWheel="Stage_MouseWheel">
                <Grid x:Name="Picture" HorizontalAlignment="Center" VerticalAlignment="Center"
                      ui:RoundedClip.Radius="10"
                      MouseLeftButtonDown="Picture_MouseDown" MouseMove="Picture_MouseMove"
                      MouseLeftButtonUp="Picture_MouseUp" LostMouseCapture="Picture_LostMouseCapture"
                      Visibility="{Binding HasImage, Converter={StaticResource Vis}}">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Zoom"/>
                            <TranslateTransform x:Name="Pan"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image Source="{Binding Current}" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Border CornerRadius="12" Padding="46,40" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource LightboxBorderBrush}" BorderThickness="1"
                        Visibility="{Binding HasImage, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <TextBlock Text="This image could not be loaded" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource LightboxTextFaintBrush}"/>
                </Border>
            </Grid>

            <Button Grid.Column="2" Style="{StaticResource GalleryButton}" Width="44" Height="44"
                    VerticalAlignment="Center" ToolTip="Next (→)" Command="{Binding NextCommand}"
                    Visibility="{Binding HasSeveral, Converter={StaticResource Vis}}">
                <ui:Icon Data="{StaticResource IconArrowRightLarge}" Size="18" Stroke="{DynamicResource LightboxIconBrush}" StrokeThickness="2.2"/>
            </Button>
        </Grid>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,18" FontSize="11"
                   Text="Scroll to zoom  ·  Drag to move  ·  Double-click to fit  ·  Esc to close"
                   Foreground="{DynamicResource LightboxTextFaintBrush}" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
