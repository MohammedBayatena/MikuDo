<UserControl x:Class="MikuDo.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MikuDo.Converters"
             xmlns:ui="clr-namespace:MikuDo.Controls"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}"
          TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,18">
            <StackPanel>
                <TextBlock Text="About" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Version, shortcuts and what is in the box." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroller}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Top">

                <Border Style="{StaticResource Card}" Padding="20" BorderThickness="{ui:ByLayout Islands=1, Flat='0,0,0,1'}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="52" Height="52" Source="pack://application:,,,/MikuDo;component/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding VersionLine}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSubtleBrush}"/>
                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentDarkBrush}"
                                       Visibility="{Binding UpdateStatus, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Check for updates"
                                FontSize="11.5" VerticalAlignment="Center" Command="{Binding CheckForUpdatesCommand}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionStrip}">
                    <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource SectionLabel}" FontWeight="Bold"
                               Margin="{ui:ByLayout Islands='2,18,2,8', Flat=0}"/>
                </Border>
                <Border Style="{StaticResource Card}" ClipToBounds="True" BorderThickness="{ui:ByLayout Islands=1, Flat='0,0,0,1'}">
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="{ui:ByLayout Islands='16,11', Flat='20,11'}" BorderBrush="{DynamicResource DividerSoftBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border MinWidth="118" CornerRadius="7" Padding="9,5"
                                                Background="{DynamicResource AccentSoftAltBrush}">
                                            <TextBlock Text="{Binding Keys}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center"
                                                       Foreground="{DynamicResource AccentDarkBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Action}" Margin="16,0,0,0" FontSize="12.5"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Style="{StaticResource SectionStrip}">
                    <TextBlock Text="FEATURES" Style="{StaticResource SectionLabel}" FontWeight="Bold"
                               Margin="{ui:ByLayout Islands='2,18,2,8', Flat=0}"/>
                </Border>
                <Border Style="{StaticResource Card}" Padding="{ui:ByLayout Islands='18,16', Flat='20,16'}"
                        BorderThickness="{ui:ByLayout Islands=1, Flat='0,0,0,1'}">
                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,9" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" — "/><Run Text="{Binding Description, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
