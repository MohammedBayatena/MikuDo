<UserControl x:Class="MikuDo.Views.ExportDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MikuDo.Converters"
             xmlns:ui="clr-namespace:MikuDo.Controls"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>

    <!--
        The shadow is a SoftShadow under the dialog, not an Effect on it. An
        Effect is worked out again whenever anything it covers is redrawn, so
        every caret blink, keystroke and scroll in the dialog would re-blur the
        whole card. Both sit in this grid, so the entrance scales them together.
    -->
    <Grid Width="680" Height="620" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform/>
        </Grid.RenderTransform>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- Collapsed rather than removed between uses, so the entrance
                         hangs off becoming visible. -->
                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource DialogIn}"/>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <ui:SoftShadow CornerRadius="14" BlurRadius="60" ShadowDepth="24" ShadowOpacity="0.28"
                       Color="{DynamicResource ShadowColor}"/>
        <Border CornerRadius="14"
                Background="{DynamicResource SurfaceBrush}"
                ui:RoundedClip.Radius="14"
                TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
            <DockPanel>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="18,16" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}">
                            <ui:Icon Data="{StaticResource IconExport}" Size="15" StrokeThickness="1.9"
                                     Stroke="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="Export to Markdown" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSubtleBrush}">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Subtitle, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Close (Esc)"
                                Command="{Binding CloseCommand}">
                            <ui:Icon Data="{StaticResource IconClose}" Size="15" StrokeThickness="2"
                                     Stroke="{DynamicResource TextFaintBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="18,14" Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFaintBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Notice}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Notice}" Value="">
                                            <Setter Property="Text" Value="Images and voice memos are left out; 100+ line descriptions are summarized."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Padding="13,8" IsEnabled="{Binding IsReady}"
                                    Command="{Binding SaveCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource IconFile}" Size="13" StrokeThickness="1.8"
                                             Stroke="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="Save as .md" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="{Binding IsReady}"
                                    Command="{Binding CopyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource IconDuplicate}" Size="13" StrokeThickness="1.9" Stroke="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                    <TextBlock Text="Copy" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                               FontWeight="Bold" Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- While it builds: what it is doing, in place of the text -->
                <Border DockPanel.Dock="Top" Padding="18,10" Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding IsWorking, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Data="{StaticResource IconAiStar}" Size="13" StrokeThickness="0"
                                 Fill="{DynamicResource AiStarBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Status}" Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentDarkBrush}"/>
                    </StackPanel>
                </Border>

                <!-- The Markdown itself, read-only but selectable -->
                <TextBox Style="{StaticResource PlainTextArea}" FontSize="12" IsReadOnly="True" Padding="18,14"
                         Background="{DynamicResource SurfaceBrush}" AcceptsTab="False"
                         Text="{Binding Markdown, Mode=OneWay}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
