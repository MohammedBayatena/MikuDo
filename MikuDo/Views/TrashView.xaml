<UserControl x:Class="MikuDo.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MikuDo.Converters"
             xmlns:ui="clr-namespace:MikuDo.Controls"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}"
          TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Trash" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Items are permanently deleted after 30 days." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Restore selected" Margin="0,0,8,0"
                            Command="{Binding RestoreSelectedCommand}"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource DangerButton}" Content="Delete selected" Margin="0,0,8,0"
                            Command="{Binding DeleteSelectedForeverCommand}"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource DangerButton}" Content="Empty trash"
                            Command="{Binding EmptyTrashCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroller}"
                      VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" ClipToBounds="True" VerticalAlignment="Top"
                    BorderThickness="{ui:ByLayout Islands=1, Flat='0,0,0,1'}">
                <StackPanel>
                    <TextBlock Text="The trash is empty." FontSize="12" Margin="16,18"
                               Foreground="{DynamicResource TextGhostSoftBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>

                    <Border Padding="{ui:ByLayout Islands='16,10', Flat='20,10'}" Background="{DynamicResource SurfaceSubtleBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource TickBox}" VerticalAlignment="Center"
                                      Click="SelectAll_Click" ToolTip="Select all"/>
                            <TextBlock Text="Select all" Margin="12,0,0,0" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSubtleBrush}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="{ui:ByLayout Islands='16,13', Flat='20,13'}" BorderBrush="{DynamicResource DividerSoftBrush}"
                                        BorderThickness="0,0,0,1" Background="Transparent"
                                        ContextMenuOpening="Row_ContextMenuOpening">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource TickBox}" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                                        <StackPanel Grid.Column="1" Margin="14,0,10,0">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSubtleBrush}">
                                                <Run Text="Deleted"/>
                                                <Run Text="{Binding DeletedLabel, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="from"/>
                                                <Run Text="{Binding Origin, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2" Margin="0,0,16,0">
                                            <ui:PriorityGlyph VerticalAlignment="Center" Priority="{Binding Priority}"
                                                              Fill="{Binding PriorityForeground}" Ghost="{DynamicResource PriorityGhostBrush}"/>
                                            <TextBlock Text="{Binding PriorityName}" Margin="5,0,0,0" FontSize="10.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Foreground="{Binding PriorityForeground}"
                                                       Visibility="{Binding HasPriority, Converter={StaticResource Vis}}"/>
                                            <ui:CommentCount Count="{Binding CommentCount}" LeadingGap="10" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding ExpiresLabel}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFaintBrush}"/>

                                        <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="Restore"
                                                Padding="11,6" FontSize="11.5"
                                                Command="{Binding DataContext.RestoreCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                                ToolTip="Delete permanently"
                                                Command="{Binding DataContext.DeleteForeverCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ui:Icon Data="{StaticResource IconTrash}" Size="14"
                                                     Stroke="{DynamicResource DangerAccentBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ShowMoreButton}" Content="{Binding MoreLabel}" ui:LoadWhenSeen.IsEnabled="True"
                            Command="{Binding ShowMoreCommand}"
                            Visibility="{Binding HasMore, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
