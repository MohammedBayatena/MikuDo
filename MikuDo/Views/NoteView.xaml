<UserControl x:Class="MikuDo.Views.NoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:conv="clr-namespace:MikuDo.Converters"
             xmlns:ui="clr-namespace:MikuDo.Controls"
             xmlns:svc="clr-namespace:MikuDo.Services"
             xmlns:views="clr-namespace:MikuDo.Views"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>
        <conv:EqualsToOnOffConverter x:Key="EqOnOff"/>
        <conv:BoolToStarWidthConverter x:Key="StarWidth"/>

        <!-- A folder above the note: clicking it opens that folder in the sidebar -->
        <Style x:Key="CrumbLink" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="text" Text="{TemplateBinding Content}" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A heading in the outline: a bar on its left marks the one last gone to -->
        <Style x:Key="OutlineRow" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="2,0,0,0" Margin="-2,0,0,0"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="text" Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="text" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="text" Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter TargetName="text" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowToolbar, Converter={StaticResource Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,14,0">
                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}">
                        <ui:Icon Data="{StaticResource IconNote}" Size="16" StrokeThickness="1.9"
                                 Stroke="{DynamicResource AccentDarkBrush}"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <!-- The folders above the note, from the folder opened under Notes that holds it -->
                        <ItemsControl ItemsSource="{Binding Crumbs}" Focusable="False" Margin="0,0,0,1"
                                      Visibility="{Binding HasCrumbs, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="›" Margin="6,0" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFaintBrush}"
                                                   Visibility="{Binding IsFirst, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                        <Button Style="{StaticResource CrumbLink}" Content="{Binding Name}" ToolTip="{Binding Path}"
                                                Command="{Binding DataContext.Main.RevealNoteFolderCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Path}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Path}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" CornerRadius="99" Padding="9,2" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding IsDirty, Converter={StaticResource Vis}}">
                                <TextBlock Text="Unsaved" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}"/>
                            </Border>
                            <Border Margin="8,0,0,0" CornerRadius="99" Padding="10,3" VerticalAlignment="Center"
                                    Background="{DynamicResource LabelAmberSoftBrush}"
                                    Visibility="{Binding ChangedOnDisk, Converter={StaticResource Vis}}">
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource LabelAmberBrush}">
                                    <Run Text="Changed on disk ·"/>
                                    <Hyperlink Command="{Binding ReloadCommand}" Foreground="{DynamicResource LabelAmberBrush}">Reload</Hyperlink>
                                </TextBlock>
                            </Border>
                            <Border Margin="8,0,0,0" CornerRadius="99" Padding="10,3" VerticalAlignment="Center"
                                    Background="{DynamicResource DangerSoftBrush}"
                                    Visibility="{Binding IsMissing, Converter={StaticResource Vis}}">
                                <TextBlock Text="Moved or deleted" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFaintBrush}"
                                   Visibility="{Binding HasCrumbs, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    </StackPanel>
                </DockPanel>

                <!-- What just happened, for a few seconds -->
                <Border Grid.Column="1" Margin="0,0,12,0" CornerRadius="99" Padding="10,4" VerticalAlignment="Center"
                        Background="{DynamicResource LabelGreenSoftBrush}"
                        Visibility="{Binding HasFlash, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Data="{StaticResource IconCheck}" Size="11" StrokeThickness="2.6" VerticalAlignment="Center"
                                 Stroke="{DynamicResource LabelGreenBrush}"/>
                        <TextBlock Text="{Binding Flash}" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LabelGreenBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="9" Padding="3" VerticalAlignment="Center"
                        Background="{DynamicResource HoverBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SegmentButton}" Content="Preview"
                                Command="{Binding SetEditorModeCommand}" CommandParameter="Preview"
                                Tag="{Binding EditorMode, Converter={StaticResource EqOnOff}, ConverterParameter=Preview}"/>
                        <Button Style="{StaticResource SegmentButton}" Content="Split"
                                Command="{Binding SetEditorModeCommand}" CommandParameter="Split"
                                Tag="{Binding EditorMode, Converter={StaticResource EqOnOff}, ConverterParameter=Split}"/>
                        <Button Style="{StaticResource SegmentButton}" Content="Edit"
                                Command="{Binding SetEditorModeCommand}" CommandParameter="Edit"
                                Tag="{Binding EditorMode, Converter={StaticResource EqOnOff}, ConverterParameter=Edit}"/>
                    </StackPanel>
                </Border>

                <!-- Saved: where it lives and the tasks in it. Unsaved: put it back, or save it. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <!-- Takes the note, unsaved changes and all, into a reader window of its own -->
                    <Button Style="{StaticResource OutlinedIconButton}" Width="34" Height="34" Margin="0,0,8,0"
                            ToolTip="Open in its own window" Command="{Binding Main.PopOutNoteCommand}"
                            Visibility="{Binding IsReader, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <ui:Icon Data="{StaticResource IconPopOut}" Size="14" StrokeThickness="2"
                                 Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDirty, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <Button Style="{StaticResource GhostButton}" Padding="12,8" Command="{Binding ShowInFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource IconFolder}" Size="13" StrokeThickness="1.9"
                                         Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Show in folder" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MakeTasksButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,9"
                                Click="MakeTasks_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource IconCheck}" Size="13" StrokeThickness="2.4" VerticalAlignment="Center"
                                         Stroke="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                <TextBlock Text="Make tasks" Margin="8,0,8,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                <ui:Icon Data="{StaticResource IconCaretDown}" Size="11" StrokeThickness="2.6" VerticalAlignment="Center"
                                         Stroke="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDirty, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource GhostButton}" Padding="12,8" Content="Revert" FontSize="12"
                                ToolTip="Drop the changes and show the file as it is on disk"
                                Command="{Binding RevertCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,9"
                                ToolTip="{Binding [app.save], Source={x:Static svc:ShortcutText.InParens}, StringFormat='Write the changes to the file{0}'}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource IconSave}" Size="13" StrokeThickness="2" VerticalAlignment="Center"
                                         Stroke="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                <TextBlock Text="Save to file" Margin="8,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                <TextBlock Text="{Binding [app.save], Source={x:Static svc:ShortcutText.Keys}}" Margin="8,0,0,0" FontSize="10.5" FontWeight="SemiBold" Opacity="0.85"
                                           VerticalAlignment="Center" Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Find ═══ -->
        <!-- A row of its own above the page: the preview is a browser window, drawn over anything laid on it -->
        <views:FindBar x:Name="FindBarView" Grid.Row="1"/>

        <!-- ═══ Outline · editor · preview ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{Binding ShowEditor, Converter={StaticResource StarWidth}}"/>
                <ColumnDefinition Width="{Binding ShowPreview, Converter={StaticResource StarWidth}}"/>
            </Grid.ColumnDefinitions>

            <!-- Outline: the note's headings, beside the preview -->
            <ScrollViewer Grid.Column="0" Width="214" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowOutline, Converter={StaticResource Vis}}">
                <StackPanel Margin="20,26,10,20">
                    <TextBlock Text="ON THIS PAGE" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFaintBrush}"/>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="2,0,0,0">
                        <ItemsControl ItemsSource="{Binding Outline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OutlineRow}" Content="{Binding Text}" Padding="{Binding Indent}"
                                            Tag="{Binding Index, Converter={StaticResource EqOnOff}, ConverterParameter=0}"
                                            Click="Outline_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Margin="0,22,0,0" Padding="12" CornerRadius="{ui:ByLayout Islands=10, Flat=0}"
                            BorderThickness="{ui:ByLayout Islands=1, Flat='0,1,0,1'}"
                            Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                            Visibility="{Binding HasOpenItems, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding OpenItemsLabel}" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Make tasks turns them into tasks, nested ones as subtasks." Margin="0,4,0,0"
                                       FontSize="12.5" LineHeight="18" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Editor -->
            <DockPanel Grid.Column="1" Visibility="{Binding ShowEditor, Converter={StaticResource Vis}}">
                <Border DockPanel.Dock="Top" Height="38" Padding="10,0,6,0"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ButtonBase.Click="Format_Click">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Width" Value="24"/>
                                <Setter Property="Height" Value="24"/>
                            </Style>
                            <Style TargetType="ui:Icon">
                                <Setter Property="Size" Value="14"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                                <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
                            </Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="1"/>
                                <Setter Property="Height" Value="14"/>
                                <Setter Property="Margin" Value="5,0"/>
                                <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
                            </Style>
                        </WrapPanel.Resources>
                        <Button Tag="heading" ToolTip="Heading"><ui:Icon Data="{StaticResource IconHeading}"/></Button>
                        <Button Tag="bold" ToolTip="Bold (Ctrl+B)"><ui:Icon Data="{StaticResource IconBold}" StrokeThickness="2.2"/></Button>
                        <Button Tag="italic" ToolTip="Italic (Ctrl+I)"><ui:Icon Data="{StaticResource IconItalic}"/></Button>
                        <Button Tag="strike" ToolTip="Strikethrough"><ui:Icon Data="{StaticResource IconStrike}"/></Button>
                        <Border/>
                        <Button Tag="quote" ToolTip="Quote"><ui:Icon Data="{StaticResource IconQuote}"/></Button>
                        <Button Tag="code" ToolTip="Code (Ctrl+E)"><ui:Icon Data="{StaticResource IconCode}"/></Button>
                        <Button Tag="codeblock" ToolTip="Code block"><ui:Icon Data="{StaticResource IconCodeBlock}" StrokeThickness="1.8"/></Button>
                        <Button Tag="link" ToolTip="Link"><ui:Icon Data="{StaticResource IconLink}"/></Button>
                        <Border/>
                        <Button Tag="bullet" ToolTip="Bulleted list"><ui:Icon Data="{StaticResource IconBulletList}" StrokeThickness="2.1"/></Button>
                        <Button Tag="number" ToolTip="Numbered list"><ui:Icon Data="{StaticResource IconNumberList}" StrokeThickness="1.9"/></Button>
                        <Button Tag="task" ToolTip="Checkbox list"><ui:Icon Data="{StaticResource IconTaskList}" StrokeThickness="1.9"/></Button>
                        <Border/>
                        <Button Tag="table" ToolTip="Table"><ui:Icon Data="{StaticResource IconTable}" StrokeThickness="1.8"/></Button>
                        <Button Tag="rule" ToolTip="Horizontal rule"><ui:Icon Data="{StaticResource IconRule}" StrokeThickness="2.2"/></Button>
                        <Button Tag="diagram" ToolTip="Insert a diagram"><ui:Icon Data="{StaticResource IconDiagram}" StrokeThickness="1.8"/></Button>
                    </WrapPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="14,7" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,1,0">
                    <TextBlock Text="{Binding StatusLine}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                </Border>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <!-- Find's matches, under the editor's text -->
                        <ui:FindHighlights x:Name="EditorMarks"/>
                        <TextBox x:Name="MarkdownBox" Style="{StaticResource PlainTextArea}"
                                 ui:Placeholder.Text="# Title&#x0a;&#x0a;Write in markdown…"
                                 PreviewKeyDown="MarkdownBox_PreviewKeyDown"
                                 SelectionChanged="MarkdownBox_SelectionChanged"
                                 ContextMenuOpening="MarkdownBox_ContextMenuOpening"
                                 Text="{Binding Markdown, UpdateSourceTrigger=PropertyChanged, Delay=120}">
                            <TextBox.ContextMenu>
                                <ContextMenu/>
                            </TextBox.ContextMenu>
                        </TextBox>

                        <!-- Lines picked out in the editor can become tasks on the spot -->
                        <Popup x:Name="SelectionChip" PlacementTarget="{Binding ElementName=MarkdownBox}" Placement="Relative"
                               AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="False">
                            <ContentControl Style="{StaticResource Popover}" Padding="5" Margin="10">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="11,6" Focusable="False" Click="SelectionTasks_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Icon Data="{StaticResource IconCheck}" Size="12" StrokeThickness="2.6" VerticalAlignment="Center"
                                                     Stroke="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                            <TextBlock x:Name="SelectionTasksLabel" Text="Make tasks" Margin="6,0,0,0" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="9,6" FontSize="12" Focusable="False"
                                            Content="As one task" Click="SelectionOneTask_Click"/>
                                </StackPanel>
                            </ContentControl>
                        </Popup>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Preview -->
            <Grid Grid.Column="2" Visibility="{Binding ShowPreview, Converter={StaticResource Vis}}">
                <Border x:Name="PreviewPlaceholder" Background="{DynamicResource SurfaceBrush}">
                    <TextBlock Text="Loading preview…" FontSize="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                </Border>
                <wv2:WebView2 x:Name="PreviewWebView" Visibility="Collapsed" DefaultBackgroundColor="Transparent"/>
                <!-- A still of the preview stands in while a dialog is over the page; the live one would draw over it -->
                <Image x:Name="PreviewStill" Visibility="Collapsed" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
