<Window x:Class="MikuDo.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MikuDo.Controls"
        Width="340" Height="180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource AppFont}">

    <Border Margin="14" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.2"
                              Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Width="52" Height="52" HorizontalAlignment="Center" Source="pack://application:,,,/MikuDo;component/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="MikuDo" Margin="0,14,0,0" FontSize="17" FontWeight="ExtraBold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="StatusText" Text="Starting…" Margin="0,6,0,0" FontSize="12"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSubtleBrush}"/>
        </StackPanel>
    </Border>
</Window>
