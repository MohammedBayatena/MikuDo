<UserControl x:Class="MikuDo.Views.LabelSuggestDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MikuDo.Converters"
             xmlns:ui="clr-namespace:MikuDo.Controls"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis"/>

        <!-- A kind label to pick for a task: outlined until chosen, then in the label's own colours -->
        <Style x:Key="KindChip" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="8,4" BorderThickness="1"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="{Binding Foreground}"/>
                                <TextBlock x:Name="text" Text="{Binding Label}" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding Background}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{Binding Foreground}"/>
                                <Setter TargetName="text" Property="Foreground" Value="{Binding Foreground}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Framed like the other dialogs: a SoftShadow beneath, the entrance on becoming visible -->
    <Grid Width="720" Height="600" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform/>
        </Grid.RenderTransform>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource DialogIn}"/>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <ui:SoftShadow CornerRadius="14" BlurRadius="60" ShadowDepth="24" ShadowOpacity="0.28"
                       Color="{DynamicResource ShadowColor}"/>
        <Border CornerRadius="14" Background="{DynamicResource SurfaceBrush}" ui:RoundedClip.Radius="14"
                TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
            <DockPanel>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="18,16" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}">
                            <ui:Icon Data="{StaticResource IconAiStar}" Size="15" StrokeThickness="0"
                                     Fill="{DynamicResource AiStarBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="Suggest labels" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSubtleBrush}">
                                <Run Text="{Binding Scope, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Subtitle, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Close (Esc)"
                                Command="{Binding CloseCommand}">
                            <ui:Icon Data="{StaticResource IconClose}" Size="15" StrokeThickness="2"
                                     Stroke="{DynamicResource TextFaintBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="18,14" Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="11"
                                   TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Notice}" Foreground="{DynamicResource TextFaintBrush}"
                                   Visibility="{Binding IsReview, Converter={StaticResource Vis}}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Padding="13,8" Content="Cancel" FontSize="12"
                                    Command="{Binding CloseCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="{Binding CanApply}"
                                    Command="{Binding ApplyCommand}"
                                    Visibility="{Binding IsReview, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding ApplyLabel}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <!-- Working: what it is reading -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40"
                                Visibility="{Binding IsWorking, Converter={StaticResource Vis}}">
                        <ui:Icon Data="{StaticResource IconAiStar}" Size="30" StrokeThickness="0"
                                 Fill="{DynamicResource AiStarBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="This can take a moment the first time the model loads."
                                   Margin="0,6,0,0" FontSize="11.5" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                    </StackPanel>

                    <!-- Nothing to label -->
                    <TextBlock Text="{Binding EmptyText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>

                    <!-- Review: each task, what it has, and the kind to add -->
                    <DockPanel Visibility="{Binding IsReview, Converter={StaticResource Vis}}">
                        <Border DockPanel.Dock="Top" Padding="18,10" BorderBrush="{DynamicResource DividerSoftBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding Suggestions.Count, Mode=OneWay}"/><Run Text=" tasks will get a label"/>
                                </TextBlock>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11.5"
                                        Content="Select all" Command="{Binding SelectAllCommand}"/>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="18,10" BorderBrush="{DynamicResource DividerSoftBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource TickBox}" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSelected}" ToolTip="Add this label"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding Labels}" Margin="0,4,0,0"
                                                                  Visibility="{Binding HasLabels, Converter={StaticResource Vis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="5" Padding="6,1" Margin="0,0,4,0" Background="{Binding Background}">
                                                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{Binding Foreground}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="No suggestion: pick one, or leave it" FontSize="10.5" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TextFaintBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WasSuggested}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Choices}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource KindChip}"
                                                                    Command="{Binding DataContext.ChooseCommand,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
