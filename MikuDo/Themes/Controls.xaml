<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:MikuDo.Controls">

    <!-- Merged here, not alongside in App.xaml, so the templates below can reach
         the storyboards with StaticResource while this dictionary is parsed. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Motion.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

    <sys:Double x:Key="Rounding">9</sys:Double>

    <!-- No dotted focus rectangles: inputs show focus with their border colour,
         and buttons are not focusable. -->
    <!--
        The keyboard focus ring. It shows only when focus arrives from the
        keyboard. Two lines: the outer one in FocusRingBrush stands out from the
        page, the inner one from the control it surrounds, so whatever the
        control's fill, one of them reaches 3:1.
    -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-3" SnapsToDevicePixels="True">
                        <Border CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}"/>
                        <Border CornerRadius="8" Margin="2" BorderThickness="1" BorderBrush="{DynamicResource FocusRingInnerBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Scroll bars ══════════════ -->

    <Style x:Key="ThinScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource GripBrush}" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="4"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- WPF's own scroll bar style sets a minimum of the system's scroll bar
             width, which outranks the 4px above. Flat drops it, so its thin
             borders are not crossed by thick bars. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="PanningMode" Value="VerticalOnly"/>
        <!-- A drop target picks up focus mid-drag; the dotted rectangle is noise. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ui:SmoothScroll.Enabled" Value="True"/>
    </Style>

    <!-- ══════════════ Typography ══════════════ -->

    <!-- No Foreground here: an implicit setter outranks inherited values, and the
         button templates rely on handing their Foreground down to plain-text content.
         Views set TextElement.Foreground on their root instead. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <!-- Small all-caps section heading, e.g. "MAIN MENU" -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextGhostBrush}"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ══════════════ Surfaces ══════════════ -->

    <!-- A panel on the page. In the Flat layout it loses its corners and frame:
         the page's own borders, set where it sits, divide it from its neighbours. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The scrolling body of a page: panels on a muted canvas in Islands,
         edge to edge on the page colour in Flat -->
    <Style x:Key="PageScroller" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        <Setter Property="Padding" Value="20,18,20,24"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Padding" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The canvas behind a page's panels where the body does not scroll -->
    <Style x:Key="PageCanvas" TargetType="Panel">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A panel's heading. In Islands it is the title row at the top of its
        card; in Flat it is a strip across the area, on a soft tint, with a
        border below. The tinted ones say what the panel is about: To do,
        Doing, Done; the plain one sits on the muted page colour.
    -->
    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="MinHeight" Value="46"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PanelHeaderTodo" TargetType="Border" BasedOn="{StaticResource PanelHeader}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StatusTodoTintBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PanelHeaderDoing" TargetType="Border" BasedOn="{StaticResource PanelHeader}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StatusDoingTintBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PanelHeaderDone" TargetType="Border" BasedOn="{StaticResource PanelHeader}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StatusDoneTintBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A section's label over its panel. In Islands the label alone, spaced by its
         own margin; in Flat a strip across the page, on the muted colour, with a
         border below, so the sections read as one list divided by borders. -->
    <Style x:Key="SectionStrip" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFlat, Source={x:Static ui:Layout.Current}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="20,10"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A count on a Flat heading: a small pill on the page colour, in the heading's ink -->
    <Style x:Key="CountPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="99"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>

    <!--
        A floating menu or panel. Its shadow is a SoftShadow under the card, not
        an Effect on it, so hovering a row or typing inside does not re-blur it.
    -->
    <Style x:Key="Popover" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <ui:SoftShadow CornerRadius="10" BlurRadius="30" ShadowDepth="12" ShadowOpacity="0.16"
                                       Color="{DynamicResource ShadowColor}"/>
                        <Border CornerRadius="10" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderFaintBrush}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- The popup re-adds this to the tree on every open, so becoming
                 visible is what marks an opening. -->
            <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PopoverIn}"/>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The foot of a long list: says how many rows are left and, with
        ui:LoadWhenSeen, shows them as it scrolls into view.
    -->
    <Style x:Key="ShowMoreButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        <Setter Property="Padding" Value="0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Buttons ══════════════ -->

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- Filled violet gradient: "Add Task", "Create task", "Unlock vault" -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform/>
                        </Grid.RenderTransform>
                        <!-- The glow is drawn once beneath, so the hover wash does not re-blur the label -->
                        <ui:SoftShadow CornerRadius="9" BlurRadius="8" ShadowDepth="2" ShadowOpacity="0.32" Color="{DynamicResource AccentGlowColor}"/>
                        <Border x:Name="bd" CornerRadius="9" Background="{DynamicResource AccentGradientBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" TextBlock.Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <!-- A wash of the label's own colour reads as "lit" on the
                             gradient, where a plain opacity drop only makes the button recede. -->
                        <Border x:Name="hover" CornerRadius="9" Opacity="0" Background="{DynamicResource ButtonPrimaryForegroundBrush}"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.14" Duration="0:0:0.11"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outlined on surface: "Cancel", "Sort", "Filter", "Lock vault" -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform/>
                        </Grid.RenderTransform>
                        <Border x:Name="bd" CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="hover" CornerRadius="8" Margin="1" Opacity="0"
                                Background="{DynamicResource HoverBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Tag="on": a toggle that is switched on -->
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftAltBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorderStrongBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One half of a split button: GhostButton's text and hover with no frame of
        its own. The SplitButtonFrame around the halves draws the outline and
        rounds the hover to it.
    -->
    <Style x:Key="SplitPartButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="Transparent">
                        <Border x:Name="hover" Opacity="0" Background="{DynamicResource HoverBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Background" Value="{DynamicResource PressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The outline around a split button's halves, matching GhostButton's -->
    <Style x:Key="SplitButtonFrame" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>

    <!-- The line between a split button's halves -->
    <Style x:Key="SplitButtonDivider" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- Violet-tinted: "AI Import Tasks" -->
    <Style x:Key="SoftAccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform/>
                        </Grid.RenderTransform>
                        <Border x:Name="bd" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"/>
                        <Border x:Name="hover" CornerRadius="9" Margin="1" Opacity="0" Background="{DynamicResource AccentTintBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outlined red: "Delete", "Empty trash" -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform/>
                        </Grid.RenderTransform>
                        <Border x:Name="bd" CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"/>
                        <Border x:Name="hover" CornerRadius="9" Margin="1" Opacity="0" Background="{DynamicResource DangerSoftBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filled green: "Export" -->
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform/>
                        </Grid.RenderTransform>
                        <Border x:Name="bd" CornerRadius="9" Background="{DynamicResource SuccessBrush}"/>
                        <Border x:Name="hover" CornerRadius="9" Opacity="0" Background="{DynamicResource ButtonSuccessForegroundBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" TextBlock.Foreground="{DynamicResource ButtonSuccessForegroundBrush}"
                                          TextBlock.FontSize="12" TextBlock.FontWeight="Bold"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.14" Duration="0:0:0.11"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}"/></Trigger.ExitActions>
