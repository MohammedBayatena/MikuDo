<!--
    Shared motion vocabulary.

    Everything is 40 to 130 ms. At this length the movement is felt but never
    waited for: the eye reads the change as the click landing, not as a
    transition playing. Anything past ~150 ms starts to feel like lag, so treat
    those numbers as a ceiling rather than a starting point.

    The storyboards address elements by name, so a template that wants one has
    to name its parts to match:

        root   the outermost element, carrying a ScaleTransform, for press feedback
        hover  a layer painted behind the content, faded in on hover
        sel    a layer painted behind the content, faded in when selected
        line   the underline of a view tab
        rail   the active marker of a sidebar row
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ══════════════ Easing ══════════════ -->

    <CubicEase x:Key="EaseOut" po:Freeze="True" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseInOut" po:Freeze="True" EasingMode="EaseInOut"/>
    <QuadraticEase x:Key="EaseOutSoft" po:Freeze="True" EasingMode="EaseOut"/>
    <!-- A small amplitude: a big overshoot needs time to settle, and time is
         exactly what these animations do not have. -->
    <BackEase x:Key="EaseOutBack" po:Freeze="True" EasingMode="EaseOut" Amplitude="0.3"/>

    <!-- ══════════════ Hover ══════════════ -->

    <Storyboard x:Key="HoverIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="0:0:0.055"/>
    </Storyboard>

    <Storyboard x:Key="HoverOut" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="0:0:0.08"/>
    </Storyboard>

    <!-- ══════════════ Selection ══════════════ -->

    <Storyboard x:Key="SelectIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="0:0:0.07"/>
    </Storyboard>

    <Storyboard x:Key="SelectOut" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="0:0:0.07"/>
    </Storyboard>

    <!-- The tab underline grows from the middle -->
    <Storyboard x:Key="TabLineIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="line" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="0:0:0.04"/>
        <DoubleAnimation Storyboard.TargetName="line" Storyboard.TargetProperty="RenderTransform.ScaleX"
                         To="1" Duration="0:0:0.11" EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="TabLineOut" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="line" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="0:0:0.06"/>
        <DoubleAnimation Storyboard.TargetName="line" Storyboard.TargetProperty="RenderTransform.ScaleX"
                         To="0" Duration="0:0:0.06"/>
    </Storyboard>

    <!-- The sidebar rail grows from its centre -->
    <Storyboard x:Key="RailIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="rail" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="0:0:0.04"/>
        <DoubleAnimation Storyboard.TargetName="rail" Storyboard.TargetProperty="RenderTransform.ScaleY"
                         To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOutBack}"/>
    </Storyboard>

    <Storyboard x:Key="RailOut" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="rail" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="0:0:0.06"/>
        <DoubleAnimation Storyboard.TargetName="rail" Storyboard.TargetProperty="RenderTransform.ScaleY"
                         To="0" Duration="0:0:0.06"/>
    </Storyboard>

    <!-- ══════════════ Press ══════════════ -->

    <Storyboard x:Key="PressIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX"
                         To="0.96" Duration="0:0:0.04"/>
        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY"
                         To="0.96" Duration="0:0:0.04"/>
    </Storyboard>

    <Storyboard x:Key="PressOut" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX"
                         To="1" Duration="0:0:0.09" EasingFunction="{StaticResource EaseOutBack}"/>
        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY"
                         To="1" Duration="0:0:0.09" EasingFunction="{StaticResource EaseOutBack}"/>
    </Storyboard>

    <!-- ══════════════ Check boxes ══════════════ -->

    <Storyboard x:Key="TickIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetName="bx" Storyboard.TargetProperty="RenderTransform.ScaleX"
                         From="0.75" To="1" Duration="0:0:0.13" EasingFunction="{StaticResource EaseOutBack}"/>
        <DoubleAnimation Storyboard.TargetName="bx" Storyboard.TargetProperty="RenderTransform.ScaleY"
                         From="0.75" To="1" Duration="0:0:0.13" EasingFunction="{StaticResource EaseOutBack}"/>
        <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.07"/>
    </Storyboard>

    <!-- ══════════════ Entrances ══════════════ -->

    <!-- Rows and cards arriving in a list. A whole column of these plays at
         once, so it stays the shortest movement in the set. -->
    <Storyboard x:Key="RowIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                         From="5" To="0" Duration="0:0:0.11" EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <!-- A modal taking the screen -->
    <Storyboard x:Key="DialogIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.07"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                         From="0.98" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                         From="0.98" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <!-- The scrim behind a modal -->
    <Storyboard x:Key="ScrimIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.07"/>
    </Storyboard>

    <!-- A popover opening under its trigger. Popup's own PopupAnimation is
         fixed at 150 ms to fade and 300 ms to slide, both far too slow for a
         menu, so the popups use None and fade themselves through this. -->
    <Storyboard x:Key="PopoverIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.06"/>
    </Storyboard>

    <!-- The drop marker while a card is dragged over a position. It has to keep
         up with the pointer, so it is the fastest thing here. -->
    <Storyboard x:Key="DropLineIn" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="1" Duration="0:0:0.04"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                         To="1" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="DropLineOut" po:Freeze="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0" Duration="0:0:0.05"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                         To="0.3" Duration="0:0:0.05"/>
    </Storyboard>

</ResourceDictionary>
